{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wieiner/Chess/assets/models/asset-manifest-v2.schema.json",
  "title": "Chess Model Asset Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "setId", "displayName", "author", "license",
    "source", "supportedApps", "units", "coordinateSystem", "defaultScale", "assets"
  ],
  "properties": {
    "format": { "const": "chess-model-assets" },
    "version": { "const": "2.0" },
    "setId": { "$ref": "#/$defs/token" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "author": { "type": "string", "minLength": 1, "maxLength": 256 },
    "license": { "$ref": "#/$defs/license" },
    "source": { "$ref": "#/$defs/source" },
    "supportedApps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "units": { "enum": ["meter", "centimeter", "millimeter", "unit"] },
    "coordinateSystem": {
      "enum": ["right-handed-y-up", "right-handed-z-up", "left-handed-y-up"]
    },
    "defaultScale": { "type": "number", "exclusiveMinimum": 0 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "$ref": "#/$defs/vector3" },
        "maximum": { "$ref": "#/$defs/vector3" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdxId", "status"],
      "properties": {
        "spdxId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "minLength": 1, "maxLength": 64 },
        "noticePath": { "$ref": "#/$defs/relativePath" },
        "notes": { "type": "string", "maxLength": 2048 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance"],
      "properties": {
        "provenance": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sourceUri": { "type": "string", "maxLength": 2048 },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId"],
      "properties": {
        "materialId": { "$ref": "#/$defs/token" },
        "baseColor": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}([A-Fa-f0-9]{2})?$" },
        "doubleSided": { "type": "boolean" }
      }
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textureId", "usage", "path", "sha256"],
      "properties": {
        "textureId": { "$ref": "#/$defs/token" },
        "usage": { "type": "string", "minLength": 1, "maxLength": 64 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "path", "sha256"],
      "properties": {
        "level": { "type": "integer", "minimum": 0, "maximum": 16 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "role", "format", "path", "sha256"],
      "properties": {
        "assetId": { "$ref": "#/$defs/token" },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "format": { "enum": ["glb", "obj"] },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "$ref": "#/$defs/vector3" },
        "origin": { "$ref": "#/$defs/vector3" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "triangleCount": { "type": "integer", "minimum": 0 },
        "vertexCount": { "type": "integer", "minimum": 0 },
        "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
        "textures": { "type": "array", "items": { "$ref": "#/$defs/texture" } },
        "lod": { "type": "array", "items": { "$ref": "#/$defs/lod" } },
        "fallbackRole": { "type": "string", "minLength": 1, "maxLength": 128 },
        "licenseOverride": { "$ref": "#/$defs/license" }
      }
    }
  }
}
