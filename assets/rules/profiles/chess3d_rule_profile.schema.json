{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/chess3d_rule_profile.schema.json",
  "title": "Chess3D Rule Profile",
  "type": "object",
  "required": [
    "rulesetId",
    "version",
    "displayName",
    "boardProfile",
    "setupProfile",
    "movementProfile",
    "captureProfile",
    "goalProfile",
    "occupancyProfile",
    "fusionProfile",
    "layerTurnProfile",
    "projectionProfile",
    "turnProfile",
    "victoryProfile",
    "randomizationProfile",
    "knownLimitations"
  ],
  "properties": {
    "rulesetId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "baseRuleset": { "type": "string" },
    "boardProfile": {
      "type": "object",
      "required": ["width", "height", "depth"],
      "properties": {
        "width": { "const": 8 },
        "height": { "const": 8 },
        "depth": { "const": 8 },
        "coordinateSystem": { "type": "string" }
      }
    },
    "mythProfile": { "type": "object" },
    "setupProfile": { "type": "object" },
    "movementProfile": { "type": "object" },
    "captureProfile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["classicCapture", "knockbackCapture"] },
        "capturedPiece": { "type": "string" },
        "fallback": { "type": "string" },
        "reserveRestoreAction": { "type": "string" },
        "status": { "enum": ["implementedByCurrentBoardModel", "runtimePartial", "specOnly", "draft", "future"] }
      }
    },
    "knockbackProfile": {
      "type": "object",
      "properties": {
        "type": { "enum": ["none", "homeOrReserve"] },
        "homeSlotPolicy": { "type": "string" },
        "fallback": { "type": "string" },
        "appliesTo": { "type": "string" },
        "coreCapturePolicy": { "type": "string" },
        "destructiveCoreCapture": { "type": "boolean" },
        "status": { "enum": ["implementedByCurrentBoardModel", "runtimePartial", "specOnly", "draft", "future"] }
      }
    },
    "reserveProfile": {
      "type": "object",
      "properties": {
        "type": { "enum": ["none", "disabled", "sidePieceTypeCounts"] },
        "restoreAction": { "type": "string" },
        "maxByPieceType": { "type": ["string", "integer"] },
        "status": { "enum": ["implementedByCurrentBoardModel", "runtimePartial", "specOnly", "draft", "future"] }
      }
    },
    "goalProfile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["classicCheckmate", "centerAssembly", "hybrid", "sandbox", "centerAssemblyTraining"] }
      }
    },
    "coreProfile": { "type": "object" },
    "occupancyProfile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["exclusive", "coreStack", "quantumCore"] },
        "outerField": { "type": "string" },
        "core": { "type": "string" },
        "maxStackSize": { "type": ["string", "integer"] },
        "ordinaryCaptureInCore": { "type": "string" },
        "status": { "enum": ["implementedByCurrentBoardModel", "runtimePartial", "specOnly", "draft", "future"] }
      }
    },
    "fusionProfile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["none", "anchorOnly", "pairFusion", "stackFusion", "colorPermutation", "volumeSurface216"] },
        "friendlyFusion": { "type": "string" },
        "enemyCoOccupancy": { "type": "string" },
        "fusionEntity": { "type": "string" },
        "royalPairFusion": { "type": "string" },
        "implosion": { "type": "string" },
        "destructiveMerge": { "type": "boolean" },
        "colorPermutation": { "type": "string" },
        "volumeSurface216": { "type": "string" },
        "fusionKind": {
          "enum": ["none", "single", "friendlyPair", "friendlyStack", "royalPair", "contested", "mixedStack", "implosionSeed", "implosionReady"]
        },
        "status": { "enum": ["implementedByCurrentBoardModel", "runtimePartial", "specOnly", "draft", "future"] }
      }
    },
    "implosionProfile": {
      "type": "object",
      "properties": {
        "type": { "enum": ["none", "centerCompletion"] },
        "mode": { "enum": ["none", "progressState"] },
        "destructive": { "type": "boolean" },
        "localSeedFromFriendlyFusion": { "type": "boolean" },
        "royalPairCountsAsFusion": { "type": "boolean" },
        "volumeSurface216Principle": { "type": "object" },
        "status": { "enum": ["implementedByCurrentBoardModel", "runtimePartial", "specOnly", "draft", "future"] }
      }
    },
    "corePhysicsProfile": {
      "type": "object",
      "properties": {
        "type": { "enum": ["none", "asgardCorePhysics"] },
        "zoneModel": { "type": "string" },
        "implementationStage": { "enum": ["specOnly", "parserOnly", "runtime"] },
        "volumeSurface216Principle": { "type": "object" },
        "layerTurnStackInteraction": { "type": "string" }
      }
    },
    "layerTurnProfile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["disabled", "ritualTurn", "globalEvent", "sandbox"] },
        "axes": { "type": "array", "items": { "enum": ["X", "Y", "Z"] } },
        "layers": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 7 } },
        "layerRange": { "type": "object" },
        "quarterTurns": { "type": "array", "items": { "enum": [-1, 1] } },
        "actionCost": { "enum": ["none", "oneTurn", "debugOnly"] },
        "movesProjectedBoard": { "type": "boolean" },
        "movesCoreStacks": { "type": "boolean" },
        "recomputesFusion": { "type": "boolean" },
        "recomputesAnchors": { "type": "boolean" },
        "reserveInteraction": { "enum": ["unaffected", "future", "none"] },
        "status": { "enum": ["implementedByCurrentBoardModel", "runtimePartial", "specOnly", "draft", "future"] },
        "notes": { "type": "string" }
      }
    },
    "projectionProfile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["none", "hodgeTriuneProjection"] },
        "enabled": { "type": "boolean" },
        "macroPlayerCount": { "type": "integer", "minimum": 0, "maximum": 6 },
        "projectionCountPerMacroPlayer": { "type": "integer", "minimum": 0, "maximum": 6 },
        "grouping": { "type": "string" },
        "mirrorPolicy": { "enum": ["allOrNothing", "skipInvalidFuture", "primaryOnlyFuture"] },
        "actionHistoryMode": { "enum": ["none", "compositeTurnWithChildren"] },
        "transformProfile": { "type": "object" },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "macroPlayer": { "type": "integer", "minimum": 1, "maximum": 6 },
              "name": { "type": "string" },
              "sideIds": {
                "type": "array",
                "items": { "type": "integer", "minimum": 1, "maximum": 6 }
              }
            }
          }
        },
        "status": { "enum": ["implementedByCurrentBoardModel", "runtimePartial", "specOnly", "draft", "future"] },
        "notes": { "type": "string" }
      }
    },
    "turnProfile": { "type": "object" },
    "victoryProfile": { "type": "object" },
    "randomizationProfile": { "type": "object" },
    "knownLimitations": { "type": "array", "items": { "type": "string" } }
  }
}
