{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/chess3d_rule_profile.schema.json",
  "title": "Chess3D Rule Profile",
  "type": "object",
  "required": [
    "rulesetId",
    "version",
    "displayName",
    "boardProfile",
    "setupProfile",
    "movementProfile",
    "captureProfile",
    "goalProfile",
    "layerTurnProfile",
    "turnProfile",
    "victoryProfile",
    "randomizationProfile",
    "knownLimitations"
  ],
  "properties": {
    "rulesetId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "baseRuleset": { "type": "string" },
    "boardProfile": {
      "type": "object",
      "required": ["width", "height", "depth"],
      "properties": {
        "width": { "const": 8 },
        "height": { "const": 8 },
        "depth": { "const": 8 },
        "coordinateSystem": { "type": "string" }
      }
    },
    "mythProfile": { "type": "object" },
    "setupProfile": { "type": "object" },
    "movementProfile": { "type": "object" },
    "captureProfile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["classicCapture", "knockbackCapture"] }
      }
    },
    "goalProfile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["classicCheckmate", "centerAssembly", "hybrid", "sandbox", "centerAssemblyTraining"] }
      }
    },
    "coreProfile": { "type": "object" },
    "layerTurnProfile": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["disabled", "ritualTurn", "globalEvent", "sandbox"] }
      }
    },
    "turnProfile": { "type": "object" },
    "victoryProfile": { "type": "object" },
    "randomizationProfile": { "type": "object" },
    "knownLimitations": { "type": "array", "items": { "type": "string" } }
  }
}
