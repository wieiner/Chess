{
  "format": "chess3d-playthrough",
  "version": "0.1",
  "scenarioId": "invalid-click-no-mutation-v0.1",
  "profileFile": "single_side_3d_v0_1.json",
  "rulesetId": "single-side-3d-8x8x8-v0.1",
  "purpose": "Regression fixture: an invalid click/move must not mutate board state or action history.",
  "steps": [
    { "type": "loadProfile" },
    { "type": "clearBoard" },
    { "type": "setPiece", "side": 1, "pieceType": 1, "x": 3, "y": 3, "z": 0 },
    { "type": "rememberStateHash", "name": "beforeInvalid" },
    { "type": "expectMoveFail", "fromX": 3, "fromY": 3, "fromZ": 0, "toX": 7, "toY": 7, "toZ": 7 },
    { "type": "assertStateHashEqualsRemembered", "name": "beforeInvalid" },
    { "type": "assertActionCount", "count": 0 },
    { "type": "assertLastInvalidReasonContains", "text": "Move rejected" }
  ],
  "knownLimitations": [
    "This fixture is headless and does not exercise WPF hit-test code directly."
  ]
}
