<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ChessUci</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ChessEngine\ChessEngine.vcxproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyNativeEngine" AfterTargets="Build">
    <PropertyGroup>
      <NativeEnginePath>$(MSBuildThisFileDirectory)..\ChessEngine\bin\$(Platform)\$(Configuration)\ChessEngine.dll</NativeEnginePath>
    </PropertyGroup>
    <Copy SourceFiles="$(NativeEnginePath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(NativeEnginePath)')" />
  </Target>
</Project>
