{
  "HostedOnline": {
    "HostUrls": "http://127.0.0.1:5077",
    "ProfileRoot": "Assets/Rules3D/Profiles",
    "RateLimitPermitLimit": 600,
    "RateLimits": {
      "Enabled": true,
      "RegisterPermitLimit": 5,
      "RegisterWindowSeconds": 600,
      "LoginPermitLimit": 10,
      "LoginWindowSeconds": 60,
      "SessionPermitLimit": 30,
      "SessionWindowSeconds": 60,
      "DiagnosticsPermitLimit": 30,
      "DiagnosticsWindowSeconds": 60
    },
    "MaxReceiveMessageBytes": 65536,
    "Auth": {
      "EnableAuthentication": true,
      "AllowDevAnonymousSessions": false,
      "AccessTokenMinutes": 30,
      "RefreshTokenDays": 14
    },
    "Persistence": {
      "StorePath": "Data/online-store.json"
    },
    "DataProtection": {
      "KeyRingPath": "Data/keys"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5077"
      }
    }
  }
}
