{
  "HostedOnline": {
    "HostUrls": "http://127.0.0.1:5077",
    "HubPath": "/chess3d/relay",
    "AllowedOrigins": [
      "http://127.0.0.1:5077",
      "http://localhost:5077"
    ],
    "MaxReceiveMessageBytes": 65536,
    "EnableDetailedErrors": false,
    "RateLimitPermitLimit": 120,
    "RateLimitWindowSeconds": 60,
    "DiagnosticsEnabled": true,
    "Auth": {
      "EnableAuthentication": false,
      "AllowDevAnonymousSessions": true,
      "AccessTokenMinutes": 30,
      "RefreshTokenDays": 14,
      "RequireHttpsForTokens": false
    },
    "Persistence": {
      "Provider": "json",
      "StorePath": "",
      "AutoCreate": true,
      "RestoreRoomsOnStartup": false
    },
    "DataProtection": {
      "ApplicationName": "Chess3D.Online",
      "KeyRingPath": ""
    }
  }
}
