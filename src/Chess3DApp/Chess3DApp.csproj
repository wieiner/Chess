<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Chess3DApp</AssemblyName>
    <RootNamespace>ChessApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chess3DEngine\Chess3DEngine.vcxproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ChessGpuBackend\ChessGpuBackend.vcxproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\ChessApp\Chess3DWindow.xaml" Link="Chess3DWindow.xaml" />
    <Compile Include="..\ChessApp\Chess3DWindow.xaml.cs" Link="Chess3DWindow.xaml.cs">
      <DependentUpon>Chess3DWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="..\ChessApp\NativeChess3DEngine.cs" Link="NativeChess3DEngine.cs" />
    <Compile Include="..\ChessApp\Chess3DNativeLibraryResolver.cs" Link="Chess3DNativeLibraryResolver.cs" />
    <Compile Include="..\ChessApp\Chess3DNetworkEndpoint.cs" Link="Chess3DNetworkEndpoint.cs" />
    <Compile Include="..\ChessApp\Chess3DVisualDescriptors.cs" Link="Chess3DVisualDescriptors.cs" />
    <Compile Include="..\ChessApp\Chess3DVisualState.cs" Link="Chess3DVisualState.cs" />
    <Compile Include="..\ChessOnlineApp\Integrations\Chess3DInternetRelayClient.cs" Link="Chess3DInternetRelayClient.cs" />
    <Compile Include="..\ChessApp\ObjModelLibrary.cs" Link="ObjModelLibrary.cs" />
    <Compile Include="..\ChessApp\NativeGpuBackend.cs" Link="NativeGpuBackend.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\models\chess\pieces\**\*.*" Link="Assets\Models\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\ChessApp\Assets\Rules3D\**\*.*" Link="Assets\Rules3D\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\profiles\**\*.*" Link="Assets\Rules3D\Profiles\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\scenarios\chess3d\**\*.*" Link="Assets\Rules3D\Scenarios\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyNative3DEngine" AfterTargets="Build">
    <PropertyGroup>
      <ThreeDEnginePath>$(MSBuildThisFileDirectory)..\..\bin\$(Platform)\$(Configuration)\Chess3DEngine.dll</ThreeDEnginePath>
      <GpuBackendPath>$(MSBuildThisFileDirectory)..\..\bin\$(Platform)\$(Configuration)\ChessGpuBackend.dll</GpuBackendPath>
      <CudaBackendPath>$(MSBuildThisFileDirectory)..\..\bin\$(Platform)\$(Configuration)\ChessCudaBackend.dll</CudaBackendPath>
    </PropertyGroup>
    <Copy SourceFiles="$(ThreeDEnginePath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(ThreeDEnginePath)')" />
    <Copy SourceFiles="$(GpuBackendPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(GpuBackendPath)')" />
    <Copy SourceFiles="$(CudaBackendPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(CudaBackendPath)')" />
  </Target>
</Project>
