<Window x:Class="RubikApp.RubikFaceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Physical Rubik Face Editor" Width="1120" Height="800" MinWidth="880" MinHeight="640"
        Background="#11161E" Foreground="#EEF3F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#35404E" />
            <Setter Property="Foreground" Value="#EEF3F8" />
            <Setter Property="BorderBrush" Value="#596779" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEF3F8" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Physical cube input" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Paint six independent U/R/F/D/L/B matrices. The live native cube is unchanged until Apply to Cube." Foreground="#AEBCCD" Margin="0,3,0,10" />
            <WrapPanel>
                <Button Content="Empty" Tag="0" Click="Palette_Click" Background="#2B3038" />
                <Button Content="White" Tag="1" Click="Palette_Click" Background="#F3F0E5" Foreground="#15191F" />
                <Button Content="Red" Tag="2" Click="Palette_Click" Background="#D64A4A" />
                <Button Content="Green" Tag="3" Click="Palette_Click" Background="#3CA66B" />
                <Button Content="Yellow" Tag="4" Click="Palette_Click" Background="#E6C84B" Foreground="#15191F" />
                <Button Content="Orange" Tag="5" Click="Palette_Click" Background="#DF843E" Foreground="#15191F" />
                <Button Content="Blue" Tag="6" Click="Palette_Click" Background="#4A73CF" />
                <TextBlock x:Name="SelectedColorText" Margin="8,0,0,8" VerticalAlignment="Center" FontWeight="SemiBold" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <TabControl x:Name="FaceTabs" SelectionChanged="FaceTabs_SelectionChanged" Background="#171D26" BorderBrush="#334052" />
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="12" Background="#171D26" BorderBrush="#334052" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Edit face" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Fill" Click="FillFace_Click" />
                            <Button Content="Rotate view 90°" Click="RotateFace_Click" />
                            <Button Content="Clear face" Click="ClearFace_Click" />
                            <Button Content="Clear all" Click="ClearAll_Click" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" />
                            <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" />
                            <Button Content="Copy face" Click="CopyFace_Click" />
                            <Button Content="Paste face" Click="PasteFace_Click" />
                        </WrapPanel>
                        <Separator Margin="0,8" />
                        <TextBlock Text="Draft file" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Save draft" Click="SaveDraft_Click" />
                            <Button Content="Load draft" Click="LoadDraft_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="CountText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock x:Name="GuidanceText" Foreground="#B8C7D8" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock x:Name="EditorErrorText" Foreground="#FF9B8D" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="96" Click="Cancel_Click" />
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Apply to Cube" MinWidth="130" Click="Apply_Click" />
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
