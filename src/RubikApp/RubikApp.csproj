<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RubikApp</AssemblyName>
    <RootNamespace>RubikApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelAssets\ModelAssets.csproj" />
    <ProjectReference Include="..\ModelAssets.Wpf\ModelAssets.Wpf.csproj" />
    <ProjectReference Include="..\RubikEngine\RubikEngine.vcxproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\RubikState\RubikState.csproj" />
    <ProjectReference Include="..\RubikVisuals\RubikVisuals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ChessApp\ObjModelLibrary.cs" Link="ObjModelLibrary.cs" />
    <Content Include="..\..\assets\models\**\*.*" Link="Assets\Models\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyNativeRubikEngine" AfterTargets="Build">
    <PropertyGroup>
      <RubikEnginePath>$(MSBuildThisFileDirectory)..\RubikEngine\bin\$(Platform)\$(Configuration)\RubikEngine.dll</RubikEnginePath>
      <LegacyRubikEnginePath>$(MSBuildThisFileDirectory)..\..\bin\$(Platform)\$(Configuration)\RubikEngine.dll</LegacyRubikEnginePath>
    </PropertyGroup>
    <Copy SourceFiles="$(RubikEnginePath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(RubikEnginePath)')" />
    <Copy SourceFiles="$(LegacyRubikEnginePath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="!Exists('$(RubikEnginePath)') And Exists('$(LegacyRubikEnginePath)')" />
  </Target>
</Project>
