<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ChessOnlineApp</AssemblyName>
    <RootNamespace>ChessOnlineApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.12" />
    <Compile Include="..\ChessApp\Chess3DNetworkEndpoint.cs" Link="Integrations\Chess3DNetworkEndpoint.cs" />
    <ProjectReference Include="..\ChessOnlineClient\ChessOnlineClient.csproj" />
    <ProjectReference Include="..\ChessOnlineProtocol\ChessOnlineProtocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\rules\profiles\**\*.*" Link="Assets\Rules3D\Profiles\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\online\**\*.*" Link="Assets\Rules3D\Online\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\scenarios\chess3d\online\**\*.*" Link="Assets\Rules3D\OnlineScenarios\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\scenarios\chess3d\signalr\**\*.*" Link="Assets\Rules3D\SignalRScenarios\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\scenarios\chess3d\identity\**\*.*" Link="Assets\Rules3D\IdentityScenarios\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\scenarios\chess3d\persistence\**\*.*" Link="Assets\Rules3D\PersistenceScenarios\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\scenarios\chess3d\matchmaking\**\*.*" Link="Assets\Rules3D\MatchmakingScenarios\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\scenarios\chess3d\asgard_online\**\*.*" Link="Assets\Rules3D\AsgardOnlineScenarios\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\rules\scenarios\chess3d\deployment\**\*.*" Link="Assets\Rules3D\DeploymentScenarios\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyNative3DEngine" AfterTargets="Build">
    <PropertyGroup>
      <ThreeDEnginePath>$(MSBuildThisFileDirectory)..\..\bin\$(Platform)\$(Configuration)\Chess3DEngine.dll</ThreeDEnginePath>
    </PropertyGroup>
    <Copy SourceFiles="$(ThreeDEnginePath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Retries="60" RetryDelayMilliseconds="1000" Condition="Exists('$(ThreeDEnginePath)')" />
  </Target>
</Project>
