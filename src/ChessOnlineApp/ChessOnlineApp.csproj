<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ChessOnlineApp</AssemblyName>
    <RootNamespace>ChessOnlineApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ChessApp\Chess3DNetworkEndpoint.cs" Link="Integrations\Chess3DNetworkEndpoint.cs" />
  </ItemGroup>
</Project>
