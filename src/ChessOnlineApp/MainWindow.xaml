<Window x:Class="ChessOnlineApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess Online Integrations"
        Width="1260"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        Background="#10151D"
        Foreground="#EDF3F8">
    <Window.Resources>
        <SolidColorBrush x:Key="OnlineWindowBrush" Color="#10151D" />
        <SolidColorBrush x:Key="OnlinePanelBrush" Color="#151D27" />
        <SolidColorBrush x:Key="OnlinePanelAltBrush" Color="#111923" />
        <SolidColorBrush x:Key="OnlinePanelHoverBrush" Color="#1C2A38" />
        <SolidColorBrush x:Key="OnlinePanelSelectedBrush" Color="#214568" />
        <SolidColorBrush x:Key="OnlineBorderBrush" Color="#2B3746" />
        <SolidColorBrush x:Key="OnlineTextBrush" Color="#EDF3F8" />
        <SolidColorBrush x:Key="OnlineMutedTextBrush" Color="#AFC0D0" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDF3F8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource OnlineWindowBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OnlineBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource OnlineMutedTextBrush}" />
            <Setter Property="Background" Value="#18202B" />
            <Setter Property="BorderBrush" Value="{StaticResource OnlineBorderBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
                    <Setter Property="Background" Value="{StaticResource OnlinePanelHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
                    <Setter Property="Background" Value="{StaticResource OnlinePanelBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0F151D" />
            <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OnlineBorderBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="#263342" />
            <Setter Property="VerticalGridLinesBrush" Value="#263342" />
            <Setter Property="RowBackground" Value="{StaticResource OnlinePanelAltBrush}" />
            <Setter Property="AlternatingRowBackground" Value="#142030" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A2430" />
            <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OnlineBorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource OnlinePanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#142030" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource OnlinePanelHoverBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource OnlinePanelSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
            <Setter Property="BorderBrush" Value="#304052" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource OnlinePanelSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
                    <Setter Property="BorderBrush" Value="#5A86B5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0F151D" />
            <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource OnlineBorderBrush}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource OnlinePanelHoverBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource OnlinePanelSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnlineTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#18202B" Padding="12" BorderBrush="#2A3442" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Online Advisor Hub" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Платформы, аккаунты, API и 3D relay вынесены из обычной шахматной доски в отдельное приложение." Foreground="#AFC0D0" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Порталы">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="PortalGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              AlternationCount="2"
                              GridLinesVisibility="Horizontal"
                              SelectionChanged="PortalGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Портал" Binding="{Binding DisplayName}" Width="170" />
                            <DataGridTextColumn Header="Транспорт" Binding="{Binding Transport}" Width="230" />
                            <DataGridTextColumn Header="Авторизация" Binding="{Binding AuthKind}" Width="130" />
                            <DataGridTextColumn Header="Возможности" Binding="{Binding Capabilities}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Background="#151D27" BorderBrush="#2B3746" BorderThickness="1" Padding="12" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="PortalTitle" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="PortalHome" Foreground="#AFC0D0" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="PortalNotes" Foreground="#D4DEE8" Margin="0,14,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Правило безопасности" FontWeight="SemiBold" Margin="0,22,0,6" />
                            <TextBlock Text="Мы не автоматизируем закрытые сайты через скрытый браузер. Ходы отправляются только там, где есть официальный или разрешённый протокол." Foreground="#AFC0D0" TextWrapping="Wrap" />
                            <Separator Margin="0,18,0,14" Background="#2B3746" />
                            <TextBlock Text="Профили интеграций" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Имя" />
                                <TextBox x:Name="AccountAliasBox" Grid.Column="1" />
                                <TextBlock Grid.Row="1" Text="Логин" Margin="0,8,0,0" />
                                <TextBox x:Name="AccountUserBox" Grid.Row="1" Grid.Column="1" Margin="4,8,0,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                                <Button Content="Сохранить профиль" Click="SavePortalAccount_Click" />
                                <Button Content="Обновить" Click="ReloadAccounts_Click" />
                            </StackPanel>
                            <ListBox x:Name="AccountListBox"
                                     Height="118"
                                     DisplayMemberPath="Summary"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <TextBlock x:Name="AccountStorePathText"
                                       Foreground="#AFC0D0"
                                       FontSize="11"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Lichess">
                <StackPanel Margin="14">
                    <TextBlock Text="Lichess Board/Bot API" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Board API — для обычного аккаунта/электронной доски. Bot API — для движка и автоходов. Эти режимы нельзя смешивать." Foreground="#AFC0D0" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Token" Width="72" />
                        <PasswordBox x:Name="LichessTokenBox" Width="420" />
                        <Button Content="Проверить" Click="LichessCheck_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Game ID" Width="72" />
                        <TextBox x:Name="LichessGameIdBox" Width="220" />
                        <ComboBox x:Name="LichessModeBox" Width="120" SelectedIndex="0">
                            <ComboBoxItem Content="Board" />
                            <ComboBoxItem Content="Bot" />
                        </ComboBox>
                        <Button Content="Stream info" Click="LichessStreamInfo_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Chess.com">
                <StackPanel Margin="14">
                    <TextBlock Text="Chess.com Published Data API" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Официальный PubAPI только читает публичные данные: профиль, статистику, архивы и текущие daily-партии. Команды и ходы он не принимает." Foreground="#AFC0D0" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Username" Width="84" />
                        <TextBox x:Name="ChessComUserBox" Width="220" />
                        <Button Content="Профиль" Click="ChessComProfile_Click" />
                        <Button Content="Daily" Click="ChessComDaily_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="ICS">
                <StackPanel Margin="14">
                    <TextBlock Text="FICS / ICC-style text server" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Исторический line-oriented протокол. Для FICS обычно freechess.org:5000; ICC/другие серверы подключать только если их правила разрешают внешний клиент." Foreground="#AFC0D0" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Host" Width="58" />
                        <TextBox x:Name="IcsHostBox" Text="freechess.org" Width="180" />
                        <TextBlock Text="Port" Margin="12,0,0,0" />
                        <TextBox x:Name="IcsPortBox" Text="5000" Width="70" />
                        <TextBlock Text="User" Margin="12,0,0,0" />
                        <TextBox x:Name="IcsUserBox" Width="140" />
                        <PasswordBox x:Name="IcsPasswordBox" Width="140" />
                        <Button Content="Connect" Click="IcsConnect_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Command" Width="72" />
                        <TextBox x:Name="IcsCommandBox" Width="420" />
                        <Button Content="Send" Click="IcsSend_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="3D Relay">
                <StackPanel Margin="14">
                    <TextBlock Text="Наша веб-платформа 3D-шахмат" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Этот клиент рассчитан на будущий сервер комнат: 6 игроков, 6 group bridges, sync board, move3d, rotate3d, chat3d." Foreground="#AFC0D0" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WebSocket" Width="82" />
                        <TextBox x:Name="RelayUriBox" Text="wss://localhost/ws/chess3d" Width="330" />
                        <TextBlock Text="Room" Margin="12,0,0,0" />
                        <TextBox x:Name="RelayRoomBox" Text="cube-main" Width="140" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Seat" Width="82" />
                        <TextBox x:Name="RelaySeatBox" Text="1" Width="58" />
                        <TextBlock Text="Group" Margin="12,0,0,0" />
                        <TextBox x:Name="RelayGroupBox" Text="0" Width="58" />
                        <TextBlock Text="Token" Margin="12,0,0,0" />
                        <PasswordBox x:Name="RelayTokenBox" Width="260" />
                        <Button Content="Connect" Click="RelayConnect_Click" />
                        <Button Content="Save profile" Click="SaveRelayProfile_Click" />
                    </StackPanel>
                    <Separator Margin="0,18,0,14" Background="#2B3746" />
                    <TextBlock Text="P3E local authority contract" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Local/in-process server-authoritative room/table harness. It validates commands through Chess3DEngine and emits authoritative snapshots/events; it is not hosted production auth or matchmaking." Foreground="#AFC0D0" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Room" Width="48" />
                        <TextBox x:Name="P3ERoomBox" Text="local-room" Width="130" />
                        <TextBlock Text="Table" Margin="12,0,0,0" />
                        <TextBox x:Name="P3ETableBox" Text="table-1" Width="110" />
                        <TextBlock Text="Player" Margin="12,0,0,0" />
                        <TextBox x:Name="P3EPlayerBox" Text="player-1" Width="120" />
                        <TextBlock Text="Seat" Margin="12,0,0,0" />
                        <TextBox x:Name="P3ESeatBox" Text="1" Width="48" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Profile" Width="48" />
                        <ComboBox x:Name="P3EProfileBox" Width="300" SelectedIndex="0">
                            <ComboBoxItem Content="classic-six-side-3d-8x8x8-v0.1" />
                            <ComboBoxItem Content="single-side-3d-8x8x8-v0.1" />
                            <ComboBoxItem Content="asgard-convergence-3d-8x8x8-v0.1" />
                            <ComboBoxItem Content="rubik-convergence-3d-8x8x8-v0.1" />
                            <ComboBoxItem Content="hodge-projection-duel-3d-8x8x8-v0.1" />
                        </ComboBox>
                        <Button Content="Create Room" Click="P3ECreateRoom_Click" />
                        <Button Content="Create Table" Click="P3ECreateTable_Click" />
                        <Button Content="Join Seat" Click="P3EJoinSeat_Click" />
                        <Button Content="Ready + Start" Click="P3EReadyStart_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Move" Width="48" />
                        <TextBox x:Name="P3EFromBox" Text="3,3,0" Width="90" />
                        <TextBlock Text="->" Margin="6,0" />
                        <TextBox x:Name="P3EToBox" Text="3,3,1" Width="90" />
                        <Button Content="Submit Move" Click="P3ESubmitMove_Click" />
                        <Button Content="Snapshot" Click="P3ESnapshot_Click" />
                        <Button Content="Action Log" Click="P3EActionLog_Click" />
                        <Button Content="Diagnostics" Click="P3EDiagnostics_Click" />
                    </StackPanel>
                    <TextBlock x:Name="P3EStatusText" Foreground="#AFC0D0" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <Separator Margin="0,18,0,14" Background="#2B3746" />
                    <TextBlock Text="P3F hosted SignalR transport" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Hosted/local SignalR server over the same P3E authority registry. P4B adds authenticated matchmaking MVP for single-server smoke; it is still not public ranked matchmaking or cloud deployment." Foreground="#AFC0D0" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <Border Background="#111923" BorderBrush="#2B3746" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Server Connection" FontWeight="SemiBold" />
                            <TextBlock Text="HTTP 80 is diagnostic/dev only. Do not enter real passwords until TLS is enabled." Foreground="#FFCF8A" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Base URL" Width="64" />
                                <TextBox x:Name="P4FBaseUrlBox" Text="http://&lt;HETZNER_HOST&gt;" Width="260" />
                                <Button Content="Use Hetzner HTTP" Click="P4FUseHetznerHttp_Click" />
                                <Button Content="Check Health" Click="P4FCheckHealth_Click" />
                                <Button Content="Check Diagnostics" Click="P4FCheckDiagnostics_Click" />
                            </StackPanel>
                            <TextBlock x:Name="P4FServerStatusText" Foreground="#AFC0D0" Margin="0,8,0,0" TextWrapping="Wrap" Text="Server status idle." />
                        </StackPanel>
                    </Border>
                    <Border Background="#111923" BorderBrush="#2B3746" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Auth / Test Users" FontWeight="SemiBold" />
                            <TextBlock Text="Temporary users are generated for diagnostic HTTP smoke. Tokens and generated passwords are kept in memory only." Foreground="#AFC0D0" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Username" Width="64" />
                                <TextBox x:Name="P4FAuthUserBox" Width="180" />
                                <TextBlock Text="Password" Margin="8,0,0,0" />
                                <PasswordBox x:Name="P4FAuthPasswordBox" Width="180" />
                                <Button Content="Register Temp" Click="P4FRegisterTemp_Click" />
                                <Button Content="Login" Click="P4FLogin_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Logout" Click="P4FLogout_Click" />
                                <Button Content="Create Two Test Players" Click="P4FCreateTwoTestPlayers_Click" />
                                <Button Content="Clear Session" Click="P4FClearSession_Click" />
                                <TextBlock x:Name="P4FAuthStatusText" Foreground="#AFC0D0" Margin="8,0,0,0" TextWrapping="Wrap" Text="Auth status: anonymous." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hub URL" Width="64" />
                        <TextBox x:Name="P3FServerUrlBox" Text="http://127.0.0.1:5077/chess3d/relay" Width="330" />
                        <Button Content="Connect" Click="P3FConnect_Click" />
                        <Button Content="Disconnect" Click="P3FDisconnect_Click" />
                        <Button Content="Hello" Click="P3FHello_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Hub Create Room" Click="P3FCreateRoom_Click" />
                        <Button Content="Hub Create Table" Click="P3FCreateTable_Click" />
                        <Button Content="Hub Join Seat" Click="P3FJoinSeat_Click" />
                        <Button Content="Hub Ready + Start" Click="P3FReadyStart_Click" />
                        <Button Content="Hub Submit Move" Click="P3FSubmitMove_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Hub Snapshot" Click="P3FSnapshot_Click" />
                        <Button Content="Hub Action Log" Click="P3FActionLog_Click" />
                        <Button Content="Hub Diagnostics" Click="P3FDiagnostics_Click" />
                        <TextBlock x:Name="P3FStatusText" Foreground="#AFC0D0" Margin="8,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Matchmaking" Width="88" />
                        <ComboBox x:Name="P3FMatchmakingProfileBox" Width="300" SelectedIndex="0">
                            <ComboBoxItem Content="classic-six-side-3d-8x8x8-v0.1" />
                            <ComboBoxItem Content="single-side-3d-8x8x8-v0.1" />
                            <ComboBoxItem Content="asgard-convergence-3d-8x8x8-v0.1" />
                            <ComboBoxItem Content="rubik-convergence-3d-8x8x8-v0.1" />
                            <ComboBoxItem Content="hodge-projection-duel-3d-8x8x8-v0.1" />
                        </ComboBox>
                        <Button Content="Join Queue" Click="P3FJoinMatchmaking_Click" />
                        <Button Content="Cancel Queue" Click="P3FCancelMatchmaking_Click" />
                        <Button Content="Queue Status" Click="P3FMatchmakingStatus_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBox x:Name="LogBox"
                 Grid.Row="2"
                 Margin="10"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="#0D1219"
                 Foreground="#EAF1F8"
                 BorderBrush="#2A3442" />
    </Grid>
</Window>
