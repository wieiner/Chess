<Window x:Class="ChessApp.Chess3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cube Chess 8x8x8" Width="1500" Height="920" MinWidth="900" MinHeight="680"
        Background="#2D333A">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#2B3138" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#242A31" />
        <SolidColorBrush x:Key="CommandBrush" Color="#20262D" />
        <SolidColorBrush x:Key="CommandBorderBrush" Color="#3B4652" />
        <SolidColorBrush x:Key="TextBrush" Color="#F3F5F7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AEB7C2" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#39424C" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#56616E" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#1D2228" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#46505C" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="#E8EDF3" />
            <Setter Property="Foreground" Value="#151A20" />
            <Setter Property="BorderBrush" Value="#46505C" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,6,0" />
        </Style>
        <Style x:Key="CommandGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CommandBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CommandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="CommandLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="CubeCellStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#171B20" Padding="12,10" BorderBrush="#303943" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="HeaderStatus"
                               DockPanel.Dock="Right"
                               Foreground="#F6D365"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Cube Chess 8x8x8" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="3D board, six-player setup, layer slices and full cube view" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                </DockPanel>

                <WrapPanel Grid.Row="1">
                    <Border Style="{StaticResource CommandGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Reset 3D" Click="Reset_Click" />
                            <Button Content="Clear" Click="Clear_Click" />
                            <Button Content="AI Move" Click="AiMove_Click" />
                            <TextBlock Text="Depth" Style="{StaticResource CommandLabelStyle}" Margin="4,0,6,0" />
                            <TextBox x:Name="DepthBox" Width="44" Text="2" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CommandGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="View" Style="{StaticResource CommandLabelStyle}" />
                            <ComboBox x:Name="ViewModeBox" Width="86" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="ViewControls_Changed">
                                <ComboBoxItem Content="Slice" />
                                <ComboBoxItem Content="All" />
                            </ComboBox>
                            <CheckBox x:Name="WideAllBox" Content="Full" IsChecked="True"
                                      Checked="ViewControls_Changed" Unchecked="ViewControls_Changed" />
                            <CheckBox x:Name="SidebarBox" Content="Side UI" IsChecked="True"
                                      Checked="ViewControls_Changed" Unchecked="ViewControls_Changed" />
                            <TextBlock Text="Axis" Style="{StaticResource CommandLabelStyle}" Margin="6,0,6,0" />
                            <ComboBox x:Name="AxisBox" Width="56" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="AxisBox_SelectionChanged">
                                <ComboBoxItem Content="Z" />
                                <ComboBoxItem Content="Y" />
                                <ComboBoxItem Content="X" />
                            </ComboBox>
                            <TextBlock Text="Layer" Style="{StaticResource CommandLabelStyle}" Margin="8,0,6,0" />
                            <ComboBox x:Name="LayerBox" Width="68" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="LayerBox_SelectionChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CommandGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Grid" Style="{StaticResource CommandLabelStyle}" />
                            <ComboBox x:Name="GridModeBox" Width="112" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="GridModeBox_SelectionChanged">
                                <ComboBoxItem Content="All" />
                                <ComboBoxItem Content="Slice" />
                                <ComboBoxItem Content="Shell" />
                                <ComboBoxItem Content="TopBottom" />
                                <ComboBoxItem Content="Middle" />
                                <ComboBoxItem Content="Occupied" />
                                <ComboBoxItem Content="Hidden" />
                            </ComboBox>
                            <TextBlock Text="Alpha" Style="{StaticResource CommandLabelStyle}" Margin="8,0,6,0" />
                            <TextBox x:Name="OpacityBox" Width="44" Text="28" VerticalAlignment="Center" LostFocus="ViewControls_Changed"
                                     ToolTip="Opacity percent for distant layers in All mode." />
                            <CheckBox x:Name="MoveHintsBox" Content="Moves" IsChecked="True"
                                      Checked="ViewControls_Changed" Unchecked="ViewControls_Changed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CommandGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Setup" Style="{StaticResource CommandLabelStyle}" />
                            <ComboBox x:Name="SideBox" Width="96" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="Palette_Changed">
                                <ComboBoxItem Content="White" />
                                <ComboBoxItem Content="Black" />
                                <ComboBoxItem Content="North" />
                                <ComboBoxItem Content="South" />
                                <ComboBoxItem Content="West" />
                                <ComboBoxItem Content="East" />
                            </ComboBox>
                            <TextBlock Text="Piece" Style="{StaticResource CommandLabelStyle}" Margin="8,0,6,0" />
                            <ComboBox x:Name="PieceBox" Width="96" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="Palette_Changed">
                                <ComboBoxItem Content="Move" />
                                <ComboBoxItem Content="Empty" />
                                <ComboBoxItem Content="Pawn" />
                                <ComboBoxItem Content="Knight" />
                                <ComboBoxItem Content="Bishop" />
                                <ComboBoxItem Content="Rook" />
                                <ComboBoxItem Content="Queen" />
                                <ComboBoxItem Content="King" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Expander Grid.Row="2"
                          Header="More controls"
                          Foreground="{StaticResource MutedTextBrush}"
                          Background="Transparent"
                          BorderBrush="{StaticResource CommandBorderBrush}">
                    <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource CommandBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,0">
                        <WrapPanel>
                            <Border Style="{StaticResource CommandGroupStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Models" Style="{StaticResource CommandLabelStyle}" />
                                    <ComboBox x:Name="ModelSetBox" Width="132" VerticalAlignment="Center" SelectionChanged="ModelSetBox_SelectionChanged" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CommandGroupStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Rubik" Style="{StaticResource CommandLabelStyle}" />
                                    <ComboBox x:Name="RubikAxisBox" Width="56" SelectedIndex="0" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Z" />
                                        <ComboBoxItem Content="Y" />
                                        <ComboBoxItem Content="X" />
                                    </ComboBox>
                                    <TextBox x:Name="RubikLayerBox" Width="40" Text="1" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Button Content="CCW" Tag="-1" Click="RubikRotate_Click" Margin="8,0,0,0" />
                                    <Button Content="CW" Tag="1" Click="RubikRotate_Click" />
                                    <Button Content="180" Tag="2" Click="RubikRotate_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CommandGroupStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Camera" Style="{StaticResource CommandLabelStyle}" />
                                    <Button Content="Iso" Click="CameraIso_Click" />
                                    <Button Content="Top" Click="CameraTop_Click" />
                                    <Button Content="Side" Click="CameraSide_Click" />
                                    <Button Content="Up" Tag="1" Click="CameraLift_Click" />
                                    <Button Content="Down" Tag="-1" Click="CameraLift_Click" />
                                    <Button Content="Reset" Click="CameraCenter_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CommandGroupStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Visuals" Style="{StaticResource CommandLabelStyle}" />
                                    <ComboBox x:Name="BackgroundThemeBox" Width="96" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="VisualOptions_Changed">
                                        <ComboBoxItem Content="Neutral" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                    <CheckBox x:Name="HighContrastBox" Content="Contrast"
                                              Checked="VisualOptions_Changed" Unchecked="VisualOptions_Changed" />
                                    <CheckBox x:Name="ShowCoreOverlayBox" Content="Core" IsChecked="True"
                                              Checked="VisualOptions_Changed" Unchecked="VisualOptions_Changed" />
                                    <CheckBox x:Name="ShowHodgeArrowsBox" Content="Hodge" IsChecked="True"
                                              Checked="VisualOptions_Changed" Unchecked="VisualOptions_Changed" />
                                    <CheckBox x:Name="ShowRubikLayerBox" Content="Rubik" IsChecked="True"
                                              Checked="VisualOptions_Changed" Unchecked="VisualOptions_Changed" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Border>
                </Expander>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolsColumn" Width="320" MinWidth="280" />
                <ColumnDefinition x:Name="LayerColumn" Width="1.05*" MinWidth="260" />
                <ColumnDefinition x:Name="PreviewColumn" Width="1.15*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ToolsPanel" Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="14" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Rule Profile" Foreground="{StaticResource MutedTextBrush}" />
                    <Grid Margin="0,6,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileComboBox" DisplayMemberPath="DisplayName" />
                        <Button Grid.Column="1" Content="Load Profile" Click="LoadProfile_Click" Margin="8,0,0,0" />
                    </Grid>
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="Refresh Profiles" Click="RefreshProfiles_Click" />
                        <TextBlock x:Name="ProfileStatusText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="8,6,0,0" />
                    </DockPanel>
                    <TextBlock x:Name="ProfileCapabilitiesText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <Expander Header="Raw rules JSON" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,0,0,10">
                        <StackPanel Margin="0,8,0,0">
                            <DockPanel>
                                <Button Content="Load JSON" DockPanel.Dock="Right" Click="LoadRules_Click" Margin="8,0,0,0" />
                                <TextBox x:Name="RulesPathBox" Text="Assets\Rules3D\cube8x8x8_draft.json"
                                         Background="#1D2228" Foreground="{StaticResource TextBrush}" BorderBrush="#46505C" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>

                    <TextBlock x:Name="RulesText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock x:Name="InfoText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                     <Expander Header="Common" IsExpanded="True" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,0,0,10">
                         <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource CommandBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                             <StackPanel>
                                <TextBlock Text="How to move: select a current-side piece, inspect legal targets, then click a highlighted target. Use Hodge Projected Move for triune mirrors and Rubik Layer Turn for layer actions."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                 <TextBlock x:Name="TurnSummaryText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                 <TextBlock x:Name="CommonPanelText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Legal actions" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,4" />
                                <ListBox x:Name="LegalActionsList" Height="126" Background="#1D2228" Foreground="{StaticResource TextBrush}" BorderBrush="#46505C" />
                                <TextBlock x:Name="InvalidReasonText" Foreground="#F6D365" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander x:Name="AsgardPanel" Header="Asgard / Core" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,0,0,10">
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource CommandBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock x:Name="AsgardPanelText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="Recompute Fusion" Click="RecomputeFusion_Click" />
                                    <Button Content="Refresh" Click="RefreshUi_Click" />
                                    <Button Content="Clear Selection" Click="ClearSelection_Click" />
                                </WrapPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Restore" Style="{StaticResource CommandLabelStyle}" />
                                    <ComboBox x:Name="ReservePieceTypeBox" Grid.Column="1" />
                                    <Button Grid.Column="2" Content="Auto" Click="AutoRestoreReserve_Click" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander x:Name="RubikPanel" Header="Rubik Layer Turn" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,0,0,10">
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource CommandBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <ComboBox x:Name="LayerTurnAxisBox" SelectedIndex="0" Margin="0,0,6,0">
                                        <ComboBoxItem Content="Z" />
                                        <ComboBoxItem Content="Y" />
                                        <ComboBoxItem Content="X" />
                                    </ComboBox>
                                    <ComboBox x:Name="LayerTurnLayerBox" SelectedIndex="0" Margin="0,0,6,0" />
                                    <ComboBox x:Name="LayerTurnQuarterBox" SelectedIndex="1">
                                        <ComboBoxItem Content="-1" />
                                        <ComboBoxItem Content="+1" />
                                    </ComboBox>
                                </UniformGrid>
                                <WrapPanel>
                                    <Button Content="Rotate Layer" Click="RotateLayerTurn_Click" />
                                    <Button Content="Check" Click="RefreshUi_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="RubikPanelText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander x:Name="HodgePanel" Header="Hodge Projection" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,0,0,10">
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource CommandBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Primary" Style="{StaticResource CommandLabelStyle}" />
                                    <ComboBox x:Name="ProjectionPrimarySideBox" Grid.Column="1" />
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,0,0,6">
                                    <TextBox x:Name="ProjectionFromXBox" Text="3" Margin="0,0,6,0" />
                                    <TextBox x:Name="ProjectionFromYBox" Text="3" Margin="0,0,6,0" />
                                    <TextBox x:Name="ProjectionFromZBox" Text="0" />
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <TextBox x:Name="ProjectionToXBox" Text="3" Margin="0,0,6,0" />
                                    <TextBox x:Name="ProjectionToYBox" Text="3" Margin="0,0,6,0" />
                                    <TextBox x:Name="ProjectionToZBox" Text="1" />
                                </UniformGrid>
                                <WrapPanel>
                                    <Button Content="Preview Mirrors" Click="PreviewProjection_Click" />
                                    <Button Content="Apply Projected Move" Click="ApplyProjectedMove_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="HodgePanelText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="Action Log" IsExpanded="True" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,0,0,10">
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource CommandBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <ListBox x:Name="ActionLogList" Height="150" Background="#1D2228" Foreground="{StaticResource TextBrush}" BorderBrush="#46505C" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Refresh" Click="RefreshActionLog_Click" />
                                    <Button Content="Copy" Click="CopyActionLog_Click" />
                                    <Button Content="Save" Click="SaveActionLog_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="Save / Replay" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,0,0,10">
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource CommandBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Save Game" Click="SaveGame_Click" />
                                    <Button Content="Load Game" Click="LoadGame_Click" />
                                    <Button Content="Export Replay" Click="ExportReplay_Click" />
                                    <Button Content="Import Replay" Click="ImportReplay_Click" />
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Replay Step" Click="ReplayStep_Click" />
                                    <Button Content="Replay All" Click="ReplayAll_Click" />
                                    <Button Content="Reset Cursor" Click="ResetReplayCursor_Click" />
                                    <Button Content="State Hash" Click="ShowStateHash_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="ReplayPanelText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="AI / Search" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,0,0,10">
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource CommandBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Depth" Style="{StaticResource CommandLabelStyle}" Margin="0,0,6,0" />
                                    <TextBox x:Name="AiDepthBox" Width="36" Text="1" VerticalAlignment="Center" />
                                    <TextBlock Text="Nodes" Style="{StaticResource CommandLabelStyle}" Margin="8,0,6,0" />
                                    <TextBox x:Name="AiNodeLimitBox" Width="64" Text="512" VerticalAlignment="Center" />
                                    <TextBlock Text="ms" Style="{StaticResource CommandLabelStyle}" Margin="8,0,6,0" />
                                    <TextBox x:Name="AiTimeLimitBox" Width="52" Text="250" VerticalAlignment="Center" />
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Candidates" Click="BuildAiCandidates_Click" />
                                    <Button Content="Search Best" Click="SearchBestAiAction_Click" />
                                    <Button Content="Make AI Move" Click="MakeBestAiAction_Click" />
                                    <Button Content="Copy Summary" Click="CopyAiSearchSummary_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="AiSearchText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="Scenario Smoke Pack" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,0,0,10">
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource CommandBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                            <StackPanel>
                                <ComboBox x:Name="ScenarioComboBox" DisplayMemberPath="DisplayName" />
                                <TextBlock x:Name="ScenarioText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <TextBlock Text="3D Network" Foreground="{StaticResource MutedTextBrush}" />
                    <Grid Margin="0,6,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NetworkHostBox" Text="127.0.0.1"
                                 Background="#1D2228" Foreground="{StaticResource TextBrush}" BorderBrush="#46505C" />
                        <TextBox x:Name="NetworkPortBox" Grid.Column="1" Text="5308" Margin="8,0,0,0"
                                 Background="#1D2228" Foreground="{StaticResource TextBrush}" BorderBrush="#46505C" />
                    </Grid>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <ComboBox x:Name="NetworkKindBox" SelectedIndex="0" Margin="0,0,8,0">
                            <ComboBoxItem Content="Player" />
                            <ComboBoxItem Content="Group" />
                        </ComboBox>
                        <ComboBox x:Name="NetworkSeatBox" SelectedIndex="0">
                            <ComboBoxItem Content="Auto" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="6" />
                        </ComboBox>
                    </UniformGrid>
                    <DockPanel Margin="0,0,0,8">
                        <Button Content="Host" Click="NetworkHost_Click" />
                        <Button Content="Connect" Click="NetworkConnect_Click" />
                        <Button Content="Stop" Click="NetworkStop_Click" />
                    </DockPanel>
                    <TextBlock x:Name="NetworkStatusText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="Placement" Foreground="{StaticResource MutedTextBrush}" />
                    <UniformGrid x:Name="PaletteGrid" Rows="2" Columns="4" Margin="0,6,0,12" />
                    <TextBox x:Name="PositionText" MinHeight="170" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="#1D2228" Foreground="{StaticResource TextBrush}" BorderBrush="#46505C" />
                    <Expander Header="Visual diagnostics" Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderBrush="{StaticResource CommandBorderBrush}" Margin="0,8,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Refresh Visual Diagnostics" Click="RefreshVisualDiagnostics_Click" />
                                <Button Content="Copy Visual Diagnostics" Click="CopyVisualDiagnostics_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="VisualDiagnosticsText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Viewbox x:Name="LayerView" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="640" Height="640">
                    <UniformGrid x:Name="LayerGrid" Rows="8" Columns="8" />
                </Grid>
            </Viewbox>

            <Border x:Name="PreviewHost" Grid.Column="2" Background="#3A4047" BorderBrush="#59636F" BorderThickness="1"
                    MouseDown="Preview3D_MouseDown"
                    MouseMove="Preview3D_MouseMove"
                    MouseUp="Preview3D_MouseUp"
                    MouseWheel="Preview3D_MouseWheel">
                <Viewport3D x:Name="Preview3D"
                            ClipToBounds="True" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
