<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ChessOnlineSignalRContractTests</AssemblyName>
    <RootNamespace>ChessOnlineSignalRContractTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.12" />
    <ProjectReference Include="..\..\src\ChessOnlineServer\ChessOnlineServer.csproj" />
    <ProjectReference Include="..\..\src\ChessOnlineProtocol\ChessOnlineProtocol.csproj" />
  </ItemGroup>

  <Target Name="CopyNative3DEngine" AfterTargets="Build">
    <PropertyGroup>
      <ThreeDEnginePath>$(MSBuildThisFileDirectory)..\..\bin\$(Platform)\$(Configuration)\Chess3DEngine.dll</ThreeDEnginePath>
    </PropertyGroup>
    <Copy SourceFiles="$(ThreeDEnginePath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Retries="60" RetryDelayMilliseconds="1000" Condition="Exists('$(ThreeDEnginePath)')" />
  </Target>
</Project>
